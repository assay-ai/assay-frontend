# Cloudflare Pages response headers (copied to out/_headers by the build).

/*
  Content-Security-Policy: frame-ancestors 'self'
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The consent and enable-paid pages (spec R-WEB-2, R-WEB-4): the strict
# policy (scripts/csp-policy.js strictPolicy()), no framing at all and no
# referrer. Cloudflare Pages joins these with the /* values by comma: two CSPs
# are both enforced (frame-ancestors 'self' and 'none' allow nothing), a
# repeated X-Frame-Options blocks framing, and the last Referrer-Policy token
# wins. `pnpm build` (scripts/connect-csp.js) completes the policy in
# out/_headers with the hashes of each page's inline scripts and the API
# origin: under /connect/* each page gets its own block with the full policy,
# and /connect/* keeps fallbackPolicy() with every page's hashes for anything
# under it without a block of its own. Cross-Origin-Opener-Policy
# same-origin-allow-popups cuts a cross-site opener off the consent window, so
# a page that opened it cannot navigate or close it between approve and
# continue, while popups the page opens itself (Privy, wallets) keep working;
# it is set on
# /connect/* and /agents/enable-paid only, once each (Cloudflare Pages joins
# repeats by comma, which makes the header invalid), and the build checks it.
/connect/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; frame-src https://auth.privy.io https://privy.goassay.ai https://verify.walletconnect.com https://verify.walletconnect.org https://challenges.cloudflare.com; connect-src 'self' https://auth.privy.io https://privy.goassay.ai https://*.rpc.privy.systems wss://relay.walletconnect.com wss://relay.walletconnect.org wss://www.walletlink.org https://explorer-api.walletconnect.com https://pulse.walletconnect.org https://api.web3modal.org https://rpc.testnet.chain.robinhood.com https://*.solana.com; worker-src 'self' blob:; manifest-src 'self'
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin-allow-popups

/agents/enable-paid
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; frame-src https://auth.privy.io https://privy.goassay.ai https://verify.walletconnect.com https://verify.walletconnect.org https://challenges.cloudflare.com; connect-src 'self' https://auth.privy.io https://privy.goassay.ai https://*.rpc.privy.systems wss://relay.walletconnect.com wss://relay.walletconnect.org wss://www.walletlink.org https://explorer-api.walletconnect.com https://pulse.walletconnect.org https://api.web3modal.org https://rpc.testnet.chain.robinhood.com https://*.solana.com; worker-src 'self' blob:; manifest-src 'self'
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Content-hashed build assets never change under the same name.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
