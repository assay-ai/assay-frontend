# Copy to `.env.local` before the first build: `cp .env.local.example .env.local`.
# Next.js loads `.env.local`, `.env` and `.env.<NODE_ENV>`.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time, so
# never put a secret here, and rebuild after changing any of them.

# Absolute base URL of this app. Every absolute link is built from it, so it
# must match the port you serve on (4000 by default; the API uses 3000).
NEXT_PUBLIC_BASE_URL=http://localhost:4000

# Base URL of the assay-backend HTTP API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Public URL of the MCP host (the backend's MCP_PUBLIC_URL), shown in every
# connect snippet. Every MCP URL sits at its root: `/` is everything,
# `/my/{slug}` one of your tool sets. The MCP server listens on MCP_PORT (3200
# by default). Unset, the snippet shows a `https://<your-mcp-host>/` placeholder.
NEXT_PUBLIC_MCP_URL=http://localhost:3200/

# The exact version of the @assay-ai/mcp proxy that every install command pins.
# Required: the build fails when it is unset or not an exact version (no range,
# no tag).
NEXT_PUBLIC_ASSAY_MCP_VERSION=1.0.0

# Your own Privy app id (https://dashboard.privy.io). Required: without a
# 25-character id the build compiles and type-checks, then fails during page
# generation with "Cannot initialize the Privy provider with an invalid Privy
# app ID". Add your local origin to the app's allowed origins in Privy.
NEXT_PUBLIC_PRIVY_APP_ID=replace-with-privy-app-id

# Optional. Set to `robinhood` to enable the demo data layer: GET requests
# that come back empty or fail are answered from built-in fixtures, so screens
# have something to show without a seeded backend. Never enable it on a
# deployment that talks to a live chain. EVM RPC endpoints are not configured
# here: the app reads each chain's public RPC from the backend's GET /chains.
# NEXT_PUBLIC_DEMO_CHAINS=robinhood
